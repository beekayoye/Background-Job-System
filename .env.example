# ==============================================================================
# REQUIRED CONFIGURATION (No Defaults - Must be set in .env)
# ==============================================================================

# PostgreSQL database connection string (Required)
DATABASE_URL=""

# Fixed API Key for authentication header Authorization: Bearer <key> or x-api-key (Required)
FIXED_API_KEY=""

# Third-party transactional email provider API key (Required)
EMAIL_API_KEY=""

# Verified sender email address required by email provider (Required)
EMAIL_FROM_ADDRESS=""


# ==============================================================================
# OPTIONAL CONFIGURATION (Locked Defaults from PRD / AGENTS.md)
# ==============================================================================

# API HTTP port (Default: 3000)
API_PORT=3000

# Maximum retry attempts before transitioning to dead status (Default: 5)
MAX_ATTEMPTS=5

# Exponential backoff base delay in milliseconds (Default: 30000 / 30s)
BACKOFF_BASE_MS=30000

# Exponential backoff maximum delay cap in milliseconds (Default: 300000 / 5m)
BACKOFF_CAP_MS=300000

# Maximum random jitter factor proportion added to backoff delay (Default: 0.2)
JITTER_FACTOR=0.2

# In-process maximum concurrent active jobs per worker process (Default: 5)
CONCURRENCY_LIMIT=5

# Threshold in milliseconds before an in-flight processing job is considered stuck (Default: 300000 / 5m)
STUCK_JOB_TIMEOUT_MS=300000

# Worker polling loop sleep interval in milliseconds (Default: 1000 / 1s)
POLL_INTERVAL_MS=1000

# Per-request HTTP timeout for outgoing email provider calls in milliseconds (Default: 10000 / 10s)
EMAIL_API_TIMEOUT_MS=10000
