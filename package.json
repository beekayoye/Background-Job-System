{
  "name": "reliable-background-job-system",
  "version": "1.0.0",
  "description": "Reliable background job processing system with PostgreSQL atomic claims, retries with backoff, and dead-letter queue.",
  "main": "dist/api/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "ts-node src/api/server.ts",
    "dev:worker": "ts-node src/worker/worker.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:break-it": "ts-node tests/break-it/01-idempotency.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
